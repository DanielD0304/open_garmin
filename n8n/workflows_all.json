  {
    "name": "Coach – Garmin Sync",
    "id": "coach-garmin-sync",
    "active": true,
    "nodes": [
      {
        "parameters": {
          "httpMethod": "POST",
          "path": "garmin/sync",
          "responseMode": "responseNode",
          "options": {}
        },
        "id": "a1000004-0001-0001-0001-000000000001",
        "name": "Webhook",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 2,
        "position": [240, 300],
        "webhookId": "garmin-sync"
      },
      {
        "parameters": {
          "method": "POST",
          "url": "http://host.docker.internal:8765/run",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify({ action: 'fetch_garmin', params: { date: $json.body.date || new Date().toISOString().split('T')[0] } }) }}",
          "options": {}
        },
        "id": "a1000004-0001-0001-0001-000000000002",
        "name": "Fetch Garmin",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4,
        "position": [480, 300]
      },
      {
        "parameters": {
          "jsCode": "const garminResult = $input.first().json;\n\nif (garminResult.status === 'error') {\n  return [{ json: garminResult }];\n}\n\nconst d = garminResult.data;\nconst h = d.health;\n\nreturn [{\n  json: {\n    ...garminResult,\n    _healthRequest: {\n      action: 'add_health',\n      params: {\n        date: d.date,\n        source: 'garmin',\n        hrv_avg: h.hrv_avg,\n        hrv_status: h.hrv_status,\n        sleep_score: h.sleep_score,\n        sleep_hours: h.sleep_hours,\n        resting_hr: h.resting_hr,\n        body_battery_high: h.body_battery_high,\n        body_battery_low: h.body_battery_low,\n        stress_avg: h.stress_avg,\n        steps: h.steps,\n        active_calories: h.active_calories\n      }\n    }\n  }\n}];"
        },
        "id": "a1000004-0001-0001-0001-000000000003",
        "name": "Parse Garmin Data",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [700, 300]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "http://host.docker.internal:8765/run",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify($json._healthRequest) }}",
          "options": {}
        },
        "id": "a1000004-0001-0001-0001-000000000004",
        "name": "Save Health to DB",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4,
        "position": [920, 300]
      },
      {
        "parameters": {
          "jsCode": "// Originale Garmin-Daten fuer Response vorbereiten\nconst prev = $('Parse Garmin Data').first().json;\ndelete prev._healthCmd;\nreturn [{ json: prev }];"
        },
        "id": "a1000004-0001-0001-0001-000000000005",
        "name": "Prepare Response",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [1140, 300]
      },
      {
        "parameters": {
          "respondWith": "json",
          "responseBody": "={{ JSON.stringify($json.data || $json) }}",
          "options": {
            "responseHeaders": {
              "entries": [
                { "name": "Access-Control-Allow-Origin", "value": "*" }
              ]
            }
          }
        },
        "id": "a1000004-0001-0001-0001-000000000006",
        "name": "Respond",
        "type": "n8n-nodes-base.respondToWebhook",
        "typeVersion": 1,
        "position": [1360, 300]
      }
    ],
    "connections": {
      "Webhook": { "main": [[{ "node": "Fetch Garmin", "type": "main", "index": 0 }]] },
      "Fetch Garmin": { "main": [[{ "node": "Parse Garmin Data", "type": "main", "index": 0 }]] },
      "Parse Garmin Data": { "main": [[{ "node": "Save Health to DB", "type": "main", "index": 0 }]] },
      "Save Health to DB": { "main": [[{ "node": "Prepare Response", "type": "main", "index": 0 }]] },
      "Prepare Response": { "main": [[{ "node": "Respond", "type": "main", "index": 0 }]] }
    },
    "settings": { "executionOrder": "v1" }
  },


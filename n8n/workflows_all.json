[
  {
    "name": "Coach – Daily Garmin Sync (Cron)",
    "nodes": [
      {
        "parameters": {
          "rule": {
            "interval": [
              {
                "field": "cronExpression",
                "expression": "0 6 * * *"
              }
            ]
          }
        },
        "id": "cron-trigger",
        "name": "Daily 06:00 Trigger",
        "type": "n8n-nodes-base.scheduleTrigger",
        "typeVersion": 1.2,
        "position": [250, 300]
      },
      {
        "parameters": {
          "url": "http://localhost:8765/api/garmin/sync",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "{ \"date\": \"={{ $now.format('yyyy-MM-dd') }}\" }",
          "options": {
            "timeout": 120000
          }
        },
        "id": "garmin-sync-request",
        "name": "Sync Garmin Data",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [480, 300]
      },
      {
        "parameters": {
          "conditions": {
            "options": {
              "caseSensitive": true,
              "leftValue": "",
              "typeValidation": "strict"
            },
            "conditions": [
              {
                "id": "condition-check",
                "leftValue": "={{ $json.status }}",
                "rightValue": "ok",
                "operator": {
                  "type": "string",
                  "operation": "equals"
                }
              }
            ],
            "combinator": "and"
          }
        },
        "id": "check-result",
        "name": "Sync OK?",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2,
        "position": [710, 300]
      },
      {
        "parameters": {},
        "id": "success-noop",
        "name": "Success (No Action)",
        "type": "n8n-nodes-base.noOp",
        "typeVersion": 1,
        "position": [940, 200]
      },
      {
        "parameters": {},
        "id": "failure-noop",
        "name": "Failure (Log Only)",
        "type": "n8n-nodes-base.noOp",
        "typeVersion": 1,
        "position": [940, 400]
      }
    ],
    "connections": {
      "Daily 06:00 Trigger": {
        "main": [
          [
            {
              "node": "Sync Garmin Data",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Sync Garmin Data": {
        "main": [
          [
            {
              "node": "Sync OK?",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Sync OK?": {
        "main": [
          [
            {
              "node": "Success (No Action)",
              "type": "main",
              "index": 0
            }
          ],
          [
            {
              "node": "Failure (Log Only)",
              "type": "main",
              "index": 0
            }
          ]
        ]
      }
    },
    "active": true,
    "settings": {
      "executionOrder": "v1"
    },
    "tags": [
      {
        "name": "garmin-cron"
      }
    ]
  }
]

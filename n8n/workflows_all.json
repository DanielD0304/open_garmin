  {
    "name": "Coach – Nutrition Add",
    "id": "coach-nutrition-add",
    "active": true,
    "nodes": [
      {
        "parameters": {
          "httpMethod": "POST",
          "path": "nutrition/add",
          "responseMode": "responseNode",
          "options": {}
        },
        "id": "a1000001-0001-0001-0001-000000000001",
        "name": "Webhook",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 2,
        "position": [240, 300],
        "webhookId": "nutrition-add"
      },
      {
        "parameters": {
          "method": "POST",
          "url": "http://host.docker.internal:8765/run",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify({ action: 'add_food', params: { date: $json.body.date, meal_label: $json.body.meal_label || 'snack', food_name: $json.body.food_name, amount_g: $json.body.amount_g || 0, calories: $json.body.calories || 0, protein_g: $json.body.protein_g || 0, carbs_g: $json.body.carbs_g || 0, fat_g: $json.body.fat_g || 0, fiber_g: $json.body.fiber_g || 0 } }) }}",
          "options": {}
        },
        "id": "a1000001-0001-0001-0001-000000000002",
        "name": "Execute DB API",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4,
        "position": [480, 300]
      },
      {
        "parameters": {
          "jsCode": "const result = $input.first().json;\nreturn [{ json: result.data || result }];"
        },
        "id": "a1000001-0001-0001-0001-000000000003",
        "name": "Parse JSON",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [700, 300]
      },
      {
        "parameters": {
          "respondWith": "json",
          "responseBody": "={{ JSON.stringify($json) }}",
          "options": {
            "responseHeaders": {
              "entries": [
                { "name": "Access-Control-Allow-Origin", "value": "*" }
              ]
            }
          }
        },
        "id": "a1000001-0001-0001-0001-000000000004",
        "name": "Respond",
        "type": "n8n-nodes-base.respondToWebhook",
        "typeVersion": 1,
        "position": [920, 300]
      }
    ],
    "connections": {
      "Webhook": { "main": [[{ "node": "Execute DB API", "type": "main", "index": 0 }]] },

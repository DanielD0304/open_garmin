# ── Garmin Connect ───────────────────────────────────────────────
GARMIN_EMAIL=deine@mail.de
GARMIN_PASSWORD=dein-passwort

# ── AI-Report (OpenAI-kompatible Cloud-API, kein lokales Modell) ──
# Default: Groq (kostenloser Tier, Key auf https://console.groq.com/keys)
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
AI_TIMEOUT=60

# Alternative kostenlose Anbieter (einfach Base-URL + Modell tauschen):
#
# OpenRouter (https://openrouter.ai/keys)
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
#
# Google Gemini (OpenAI-Compat, https://aistudio.google.com/apikey)
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-2.0-flash
#
# Cerebras (https://cloud.cerebras.ai)
# AI_BASE_URL=https://api.cerebras.ai/v1
# AI_MODEL=llama-3.3-70b
